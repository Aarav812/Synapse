PORT=3000
FIREBASE_PROJECT_ID=your_firebase_project_id

# Firebase Admin credentials (required for /api/chat and /api/verify-token auth).
# Provide ONE of the following:
#  - FIREBASE_SERVICE_ACCOUNT: the FULL service-account JSON, pasted on a single
#    line (escape inner quotes) or loaded via your env manager.
#  - GOOGLE_APPLICATION_CREDENTIALS: path to a service-account JSON file.
# If neither is set, the server boots but token verification will fail until
# credentials are supplied.
FIREBASE_SERVICE_ACCOUNT=
# GOOGLE_APPLICATION_CREDENTIALS=

# ── AI provider ──
# All Aura models route through a SINGLE NVIDIA API key/endpoint.
# Set NVIDIA_API_KEY (or DEFAULT_API_KEY) and NVIDIA_BASE_URL.
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=your_nvidia_api_key
# DEFAULT_API_KEY is used as a fallback if NVIDIA_API_KEY is not set.
DEFAULT_API_KEY=your_nvidia_api_key

# Model routing (all on NVIDIA, single key):
#   Aura Allrounder — Deep Think : nvidia/gpt-oss-120b
#   Aura Allrounder — Fast       : nvidia/laguna-xs-2.1
#   Aura Summary                 : nvidia/gpt-oss-120b
#   Aura Bhai                    : nvidia/nemotron-3-super-120b-a12b
#   Analyze (image/audio/video)  : nvidia/nemotron-3-nano-omni-30b-a3b-reasoning

# Optional: restrict CORS to your frontend origin(s), comma-separated.
# Leave empty to allow all origins (development convenience).
FRONTEND_ORIGIN=

# AI API Keys
AI_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
DEFAULT_API_KEY=your_default_nvidia_api_key
NVIDIA_API_KEY=your_nvidia_api_key

# OpenRouter (used for Aura 1 / Minimax and Aura 2 / GPT-OSS-120B)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=your_openrouter_api_key
GPT_OSS_120B_API_KEY=your_gpt_oss_api_key

# Model-specific keys
STEP_FLASH_API_KEY=your_step_flash_api_key
QWEN_API_KEY=your_qwen_api_key
VISION_API_KEY=your_vision_api_key
AUDIO_VIDEO_API_KEY=your_audio_video_api_key
